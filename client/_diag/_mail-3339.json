{"html": "<html>\r\n<head>\r\n    <meta http-equiv=\"Content-Type\" content=\"text/html;charset=UTF-8\"/>\r\n    <title>招商证券资产管理有限公司对账单</title>\r\n    <style>td {\r\n        font-size: 12px;\r\n    }\r\n\r\n    input[type=text] {\r\n        border: #aaaaaa dotted 0px;\r\n        border-bottom: #aaaaaa dotted 1px;\r\n    }\r\n\r\n    .table1x {\r\n        width: 843px;\r\n        /* width: 906px; */\r\n    }\r\n\r\n    .table1x, .table1x td {\r\n        border-collapse: collapse;\r\n    }\r\n\r\n    .table1x tr:nth-child(2n+1) td{\r\n        background-color:  #ded9db!important;\r\n    }\r\n    /* .table1x tr:odd td{\r\n        background-color:  #ded9db!important;\r\n    } */\r\n\r\n    .table1x .even td{\r\n        background-color:  #ded9db!important;\r\n    }\r\n\r\n\r\n\r\n    .table1x th {\r\n        /* background: #cccccc; */\r\n        height: 20px;\r\n        /* line-height: 20px; */\r\n        font-size: 12px;\r\n        border-left: 2px solid #fff;\r\n        background-color: #c00403;\r\n        color: #fff;\r\n        text-align: center!important;\r\n    }\r\n\r\n    .table1x td {\r\n        font-size: 12px;\r\n        /* padding: 4px; */\r\n    }\r\n    .table1x tr td {\r\n        border-left: 2px solid #fff;\r\n        text-align: center!important;\r\n        padding: 5px 3px;\r\n        line-height: 16px;\r\n    }\r\n    .base_color{\r\n        color: #b80000;\r\n    }\r\n    .base_title{\r\n        color: #b80000;\r\n        padding: 10px 0;\r\n        box-sizing: border-box;\r\n        border-bottom: 1px dashed #e7be5d;\r\n        margin: 3px 0px;\r\n        font-weight: bold;\r\n        font-size: 18px;\r\n    }\r\n\r\n    .base_time{\r\n        font-size: 12px;\r\n        margin: 10px 0px;\r\n        color: #b80000;\r\n\r\n    }\r\n    body{\r\n        /* background-color: #fff; */\r\n    }\r\n    .flex_row{\r\n        display: flex;\r\n    }\r\n\r\n    .over{\r\n        width: 16px;\r\n        font-size: 10px;\r\n        line-height: 12px;\r\n        padding: 5px;\r\n        display: inline-block;\r\n    }\r\n\r\n    .duizhangdan{\r\n        margin:18px 0px;\r\n        color: #e33e54;\r\n        font-size: 28px;\r\n        text-align: right;\r\n    }\r\n    .other{\r\n        font-size: 14px;\r\n        margin-top: 30px;\r\n    }\r\n    .link{\r\n        color: #000;\r\n        text-decoration: underline!important;\r\n    }\r\n    .flex_between{\r\n        /* display: flex;\r\n        justify-content: space-between; */\r\n    }\r\n    .imgcorp{\r\n        width: 300px!important;\r\n        height: 55px!important;\r\n        background-image: url(https://amc.cmschina.com/csmap/am/am_bill/cma-logo-1.png)!important;\r\n        background-size: 200% 100%!important;\r\n        background-position: center!important;\r\n        margin-left: -10px;\r\n        margin-top: 20px;\r\n    }\r\n\r\n    .custInfo tr{\r\n        padding: 5px 0px;\r\n    }\r\n    </style>\r\n</head>\r\n<body style=\"margin-top:0;padding: 0px 10px;\" >\r\n   <div style=\"width: 843px;\">\r\n    <div class=\"flex_row flex_between\" style=\"margin-top: 10px;\">\r\n        <div >\r\n             <div class=\"imgcorp\">\r\n             </div>\r\n            <div style=\"margin: 30px 0px 0px 0px;\">\r\n             <table class=\"custInfo\">\r\n                \t<tr><td>客户名称：董吉祥</td></tr>\r\n\t<tr><td>基金帐号：980519483604</td></tr>\r\n\r\n             </table>\r\n            </div>\r\n\r\n        </div>\r\n        <div  style=\"margin-left: auto;margin-right: 20px;\">\r\n            <img style=\"width: 100px;height: 100px;vertical-align: top;\" src=\"https://amc.cmschina.com/csmap/am/am_bill/bill_qrcode.png\" />\r\n            <div class=\"over\">关注公众号扫一扫</div>\r\n        </div>\r\n\r\n        <div style=\"padding-left: 10px;\" >\r\n            <div class=\"duizhangdan\">招商资管对账单</div>\r\n            <div class=\"other\">了解更多资讯? <a class=\"link\" target=\"_blank\" href=\"https://amc.cmschina.com/#/home/page\" >进入招商资管官网</a></div>\r\n        </div>\r\n    </div>\r\n\r\n    <div class=\"base_title\" style=\"margin-top:20px\">您的持有份额信息</div>\r\n    <div class=\"base_time\">截至日期:  2026-07-31</div>\r\n\r\n<table bgcolor=\"#ffffff\" cellpadding=0 cellspacing=0 border=0>\r\n    <tr>\r\n        <td style=\"border:0;\">\r\n            <table align=\"center\" class=\"table1x\">\r\n                <tr>\r\n                    <th>产品代码</th>\r\n                    <th>产品名称</th>\r\n                    <th>风险等级</th>\r\n                    <th>份额余额(份)</th>\r\n                    <th>冻结份额(份)</th>\r\n                    <th>未结转收益(份)</th>\r\n                    <th>期末单位净值(元/份)</th>\r\n                    <th>期末市值(元)</th>\r\n                    <th>销售商</th>\r\n                </tr>\r\n                <tr>\r\n\t<td>880013</td>\r\n\t<td>招商资管智远天添利货币</td>\r\n\t<td>R1</td>\r\n\t<td>7772.64</td>\r\n\t<td>0</td>\r\n\t<td>1.17</td>\r\n\t<td>1</td>\r\n\t<td>7772.64</td>\r\n\t<td>招商证券股份有限公司</td>\r\n</tr>\r\n\r\n            </table>\r\n        </td>\r\n    </tr>\r\n\r\n</table>\r\n\r\n<div style=\"margin-top: 20px;\"></div>\r\n<div class=\"base_title\">您本期的交易明细</div>\r\n<div class=\"base_time\">交易日期:  2026-07-01 ~ 2026-07-31</div>\r\n\r\n<table bgcolor=\"#ffffff\" cellpadding=0 cellspacing=0 border=0>\r\n    <tr>\r\n        <td style=\"border:0;\">\r\n            <table align=\"center\" class=\"table1x\">\r\n                <tr>\r\n                    <th>申请日期</th>\r\n                    <th>确认日期</th>\r\n                    <th>交易类别</th>\r\n                    <th>产品名称</th>\r\n                    <th>参与金额<br>/退出份额</th>\r\n                    <th>确认金额(元)</th>\r\n                    <th>确认份额(份)</th>\r\n                    <th>清单算位净值</th>\r\n                    <th>手续费(元)</th>\r\n                    <th>业绩报酬</th>\r\n                    <th>销售商</th>\r\n                </tr>\r\n                <tr>\r\n\t<td>20260722</td>\r\n\t<td>20260723</td>\r\n\t<td>红利发放</td>\r\n\t<td>招商资管智远天添利货币</td>\r\n\t<td>0</td>\r\n\t<td>4.37</td>\r\n\t<td>0</td>\r\n\t<td></td>\r\n\t<td>0</td>\r\n\t<td>0</td>\r\n\t<td>招商证券股份有限公司</td>\r\n</tr>\r\n\r\n            </table>\r\n        </td>\r\n    </tr>\r\n\r\n</table>\r\n\r\n\r\n\r\n    <div style=\"font-weight: bold;padding-top: 30px;line-height: 1.5\" >说明：</div>\r\n\r\n    <div style=\"font-size: 10px; color:grey;padding-left: 30px;line-height: 1.3\">\r\n        1、份额余额：指账单日您持有我公司产品的份额；<br/>\r\n        2、未结转收益：指账单日货币类产品当前未结转的收益；<br/>\r\n        3、期末单位净值：指账单日的单位资产净值；<br/>\r\n        4、清算单位净值：指交易确认时的清算价格；<br/>\r\n        5、手续费：指交易确认时收取的费用；<br/>\r\n        6、期末市值：指账单日您持有产品份额的资产价值，期末市值=份额余额X期末单位净值；<br/>\r\n        7、业绩报酬：指客户退出时管理人计提的业绩报酬。业绩报酬的金额是根据产品合同和说明书的有关约定来计算。\r\n    </div>\r\n    <div style=\"padding-top:10px;border:0;\"><img style=\"width: 843px;\" src=\"https://amc.cmschina.com/csmap/am/am_bill/bill_bottom_v1.png\"></div>\r\n   </div>\r\n</body>\r\n</html>\r\n"}